# ---------------------------------------------------------------
# 汉字笔顺 — static site. Everything needed to run is committed:
#   index.html, vendor/*.js (the libraries), data/*.js (the offline
#   character + stroke-order data, ~6 MB).
#
# data/*.js is *generated* by tools/build-data.mjs, but it is committed
# on purpose — it is what lets the tool run with no network and no build
# step. Do not add data/ to this file.
# ---------------------------------------------------------------

# OS cruft
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.code-workspace
*~
*.swp
*.swo

# Node (only needed if you run the data build with local deps)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Scratch
tmp-*/
*.log

# Tool cache — regenerable, and not needed to run the tool.
# tools/.cache/jieba-dict.txt is the 4.9 MB jieba frequency dictionary, fetched
# on demand and used by tools/check-words.mjs only to *validate* that authored
# 组词 are real words (it is never a source for choosing them). Re-fetch it when
# re-deriving content; it does not belong in history.
tools/.cache/

# Generated by tools/build-words.mjs — the machine-selected 组词 list picked
# straight from the jieba frequency dictionary. Kept only as the record of an
# approach that was tried and rejected: it produced 秋 -> 秋审/余秋雨 and
# 水 -> 降水量 for a seven-year-old. The shipped 组词 are hand-authored in
# content/words/*.json (each with a 释义), and nothing reads this file.
content/words.json

